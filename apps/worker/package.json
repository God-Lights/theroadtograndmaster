{
  "name": "@rtgm/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply rtgm --local",
    "db:migrate:remote": "wrangler d1 migrations apply rtgm --remote",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@rtgm/data": "*",
    "@rtgm/engine": "*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^22.20.5",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
